# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#   cp .env.example .env

# --- LLM reasoning -----------------------------------------------------------
# Whichever key is set is used; Anthropic wins if both are present. With neither,
# the deterministic rule-based analyzer runs and the gate still works.
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# CONTEXTCI_GROQ_MODEL=openai/gpt-oss-120b     # must support JSON schema output
# CONTEXTCI_GROQ_MAX_TOKENS=4000               # Groq free tier is 8000 TPM

# --- DataHub -----------------------------------------------------------------
DATAHUB_GMS_URL=http://localhost:8081
DATAHUB_FRONTEND_URL=http://localhost:9002
# Platform and env used to resolve a table name to a dataset URN.
# The DataHub sample data is `hive`; your own warehouse is probably not.
DATAHUB_PLATFORM=hive
DATAHUB_ENV=PROD
# Required once METADATA_SERVICE_AUTH_ENABLED=true.
# Mint one with: python scripts/make_datahub_token.py
# DATAHUB_GMS_TOKEN=

# --- GitHub (only for running against a real pull request) -------------------
# In GitHub Actions these come from the event and secrets; set them only locally.
# GITHUB_TOKEN=ghp_...            # needs contents:write + pull-requests:write
# GITHUB_REPOSITORY=owner/repo
# PR_NUMBER=1

# --- Behaviour ---------------------------------------------------------------
TOOLS_IS_MUTATION_ENABLED=true    # false for a read-only dry run
CONTEXTCI_AUTOFIX=false           # true commits generated migrations to the PR branch
CONTEXTCI_MENTION_OWNERS=false    # true @-mentions DataHub owners (verify handles first)
# CONTEXTCI_LOG_LEVEL=INFO
