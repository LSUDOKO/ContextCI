{
  "name": "ContextCI",
  // Python 3.11 is required: 3.14 has no pydantic-core wheels.
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "features": {
    // DataHub's quickstart is a docker-compose stack, so the Codespace needs its
    // own Docker daemon.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },

  // DataHub needs ~6 GB resident (GMS 1.9, OpenSearch 1.3, plus Kafka, MySQL,
  // frontend and actions), and its CLI refuses to start the quickstart with less
  // than 13 GB of free Docker disk. The 2-core/8 GB default cannot run it.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "forwardPorts": [8081, 9002],
  "portsAttributes": {
    "8081": { "label": "DataHub GMS (API)", "onAutoForward": "silent" },
    "9002": { "label": "DataHub UI (datahub/datahub)", "onAutoForward": "notify" }
  },

  "postCreateCommand": "pip install --user -r requirements-dev.txt && cp -n .env.example .env || true",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
